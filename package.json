{
  "name": "harmonix-music-player",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run electron:dev",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "electron:build": "vite build && electron-builder --win"
  },
  "build": {
    "appId": "com.harmonix.musicplayer",
    "productName": "Harmonix",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Harmonix-Standard-Installer.exe",
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Harmonix"
    },
    "portable": {
      "artifactName": "Harmonix-Standalone-Portable.exe"
    }
  },
  "dependencies": {
    "idb": "^8.0.2",
    "lucide-react": "^0.475.0",
    "music-metadata": "^11.14.0",
    "music-metadata-browser": "^2.5.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@reticlehq/browser": "^2.5.0",
    "@reticlehq/electron": "^2.5.0",
    "@reticlehq/react": "^2.5.0",
    "@reticlehq/vite-plugin": "^2.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "tailwindcss": "^4.3.3",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
